RAGSTACK_DATABASE_URL=postgresql://ragstack:ragstack@localhost:5433/ragstack

# Engines. Offline defaults need no keys: fastembed (local ONNX) for embeddings + reranking,
# and the scripted LLM for tests. For real answers set an LLM key.
RAGSTACK_EMBEDDER=fastembed          # fastembed | openai | hashing (tests only)
RAGSTACK_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RAGSTACK_EMBEDDING_DIMENSION=384     # must match the embedder; schema is created with it
RAGSTACK_RERANKER=fastembed          # fastembed | cohere | lexical (tests only) | none
RAGSTACK_LLM=anthropic               # anthropic | openai | scripted (tests only)
RAGSTACK_ANTHROPIC_API_KEY=
RAGSTACK_ANTHROPIC_MODEL=claude-sonnet-5-5
RAGSTACK_JUDGE_MODEL=                # separate judge model for evals; defaults to the main LLM
RAGSTACK_OPENAI_API_KEY=
RAGSTACK_COHERE_API_KEY=

RAGSTACK_CONFIG_PATH=                # RetrievalConfig YAML, see evals/configs/
RAGSTACK_API_KEY=                    # Bearer token for the HTTP API when set
RAGSTACK_LOG_LEVEL=INFO
